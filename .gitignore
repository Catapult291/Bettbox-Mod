/test/build/
# Unsupported generated iOS platform
/ios/

# Xcode project-local SwiftPM state; keep the workspace Package.resolved
/macos/Runner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
/services/helper/target/
/rust/target/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

/android/core/.cxx

#libclash
/libclash/

#jniLibs
/android/app/src/main/jniLibs/
/android/core/src/main/jniLibs/

# Tool-generated local configuration
/plugins/flutter_distributor/packages/flutter_distributor/devtools_options.yaml

# FVM Version Cache
.fvm/
.fvmrc
# 本地散件：构建产物归档、验证截图、本机辅助脚本（都不入库）
/archive/
/tools/
/*旧脚本.txt

# 交付用的构建产物落在工作区根，方便取用，不入库
/Bettbox-*.apk
/Bettbox-*.zip
/Bettbox-*-setup.exe
/Bettbox-*-windows-*/
/BettboxHelperService.exe

# 截图工具在本机留下的图片（可能含订阅链接等隐私内容），不入库
/PixPin_*.png
